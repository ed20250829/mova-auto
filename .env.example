# Site
PUBLIC_SITE_URL=https://mova-auto.tech
PUBLIC_TELEGRAM_BOT_URL=https://t.me/mova_auto_bot
# Click-to-call on callback widget (E.164). Fallback in UI: +375447149978
PUBLIC_PHONE=+375447149978
# Demo "ТЕСТ · ОБРАЗЦЫ" banner. Prod default: hidden. Set to 1 on hoster to show (runtime).
# Also shown automatically in `astro dev`. If you dismissed it once, clear localStorage key mova_sample_banner_dismissed.
# PUBLIC_SHOW_SAMPLE_BANNER=1


# Admin auth (cookie token). Set a long random string.
ADMIN_TOKEN=change-me-to-a-long-random-secret

# Telegram Bot API (never commit real values)
TELEGRAM_BOT_TOKEN=
# Owner/admin chat id (get via @userinfobot or getUpdates after /start)
TELEGRAM_CHAT_ID=
# Optional secret for webhook header x-telegram-bot-api-secret-token
TELEGRAM_WEBHOOK_SECRET=
# Optional address line in bot status messages
# PUBLIC_ADDRESS=Минск, ул. Примерная 1

# Optional partner bot (importer notifications)
TELEGRAM_PARTNER_BOT_TOKEN=
TELEGRAM_PARTNER_CHAT_ID=

# SQLite path (relative to project root). For Postgres later use DATABASE_URL.
DATABASE_PATH=./data/mova.db

# Uncomment when migrating to Postgres:
# DATABASE_URL=postgresql://user:pass@host:5432/mova

# bePaid / online payments (phase 2b — leave empty until contract + keys)
# Shop ID from bePaid dashboard
BEPAID_SHOP_ID=
# Secret key for creating payments (server only — never PUBLIC_)
BEPAID_SECRET_KEY=
# Optional public key for widget (if used)
BEPAID_PUBLIC_KEY=
# Shared secret to verify POST /api/payments/webhook
BEPAID_WEBHOOK_SECRET=
# Test mode flag for future integration
BEPAID_TEST_MODE=true
