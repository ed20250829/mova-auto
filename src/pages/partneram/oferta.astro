---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import {
  organizationJsonLd,
  SITE_EMAIL,
  SITE_PHONE_DISPLAY,
  SITE_PHONE_E164,
  SITE_URL,
} from '../../lib/seo';

const title = 'Краткая оферта для автосалонов | Мова';
const description =
  'Черновик условий партнёрства Мовы с автосалонами Минска: предмет услуги, гарантия, порядок выхода на договор.';
---

<BaseLayout title={title} description={description} jsonLd={[organizationJsonLd()]}>
  <SiteHeader />
  <main id="main" class="section">
    <div class="container oferta-page">
      <p class="kicker">Документы · черновик</p>
      <h1 class="display">Краткая оферта для автосалонов</h1>
      <p class="lead muted">
        Рабочий черновик для переговоров - не подписанный договор. Полный текст и реквизиты согласуем отдельно.
      </p>

      <section aria-labelledby="oferta-subject">
        <h2 id="oferta-subject">1. Предмет</h2>
        <p class="muted">
          Исполнитель (Мова) настраивает программное обеспечение мультимедийной системы автомобиля:
          русское меню и настройки там, где позволяет система, плюс согласованные опции
          (пакет приложений, страховка после обновления ПО).
        </p>
        <p class="muted">
          Услуга не является ремонтом автомобиля, диагностикой узлов, тюнингом или чип-тюнингом.
        </p>
      </section>

      <section aria-labelledby="oferta-frame">
        <h2 id="oferta-frame">2. Коммерческая рамка</h2>
        <ul class="muted">
          <li>Формат: направление клиента салона и работа под бренд салона для машин к выдаче</li>
          <li>Цена: за машину в BYN по модели; от 5-8 авто в месяц - индивидуальная сетка</li>
          <li>Ответ в рабочие часы 08:00-22:00 (Europe/Minsk) - в тот же день</li>
          <li>Приоритетные слоты для клиентов салона - по согласованному каналу заявок</li>
          <li>Материалы: QR, листовка, по договорённости - промокод канала салона</li>
        </ul>
      </section>

      <section aria-labelledby="oferta-warranty">
        <h2 id="oferta-warranty">3. Гарантия</h2>
        <p class="muted">
          6 месяцев на выполненное русское меню - в объёме, согласованном при приёмке работы.
          Не покрывает сторонние прошивки и вмешательства без согласования.
        </p>
      </section>

      <section aria-labelledby="oferta-pdn">
        <h2 id="oferta-pdn">4. Персональные данные</h2>
        <p class="muted">
          Контакты из формы на <a href="/partneram">/partneram</a> обрабатываются для связи по заявке партнёра.
          Подробнее - в <a href="/privacy">политике ПДн</a>.
        </p>
      </section>

      <section aria-labelledby="oferta-next">
        <h2 id="oferta-next">5. Дальше</h2>
        <p class="muted">
          Обсудим договор: объём, цены, отчётность, закрывающие. Связь:
          <a href={`tel:${SITE_PHONE_E164}`}>{SITE_PHONE_DISPLAY}</a>,
          <a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>,
          форма на <a href="/partneram#partner-form">{SITE_URL}/partneram</a>.
        </p>
      </section>

      <p class="muted oferta-back">
        <a href="/partneram">← К условиям для автосалонов</a>
      </p>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .oferta-page {
    max-width: 42rem;
    display: grid;
    gap: 1.15rem;
  }
  h1.display {
    font-size: clamp(1.9rem, 4.5vw, 2.8rem);
    margin: 0;
    max-width: 16ch;
  }
  .lead {
    margin: 0;
  }
  section {
    display: grid;
    gap: 0.45rem;
  }
  h2 {
    margin: 0;
    font-size: 1.15rem;
  }
  p,
  ul {
    margin: 0;
  }
  ul {
    padding-left: 1.1rem;
    display: grid;
    gap: 0.35rem;
  }
  .oferta-back {
    margin-top: 0.5rem;
    font-size: 0.95rem;
  }
</style>
