---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDashboardStats } from '../../lib/admin-stats';
import { getTodayInbox } from '../../lib/admin-inbox';
import { formatByn } from '../../lib/format';
import DashboardCharts from '../../components/admin/DashboardCharts';
import InboxPanel from '../../components/admin/InboxPanel';
import SiteBannerToggle from '../../components/admin/SiteBannerToggle';
import GarageToday from '../../components/admin/GarageToday';
import { ensureDb } from '../../lib/models';
import { getShowSampleBanner } from '../../lib/site-settings';
import { getMinskParts } from '../../lib/minsk-hours';
import { db } from '../../db';
import { orders } from '../../db/schema';
import { desc } from 'drizzle-orm';

ensureDb();
const s = getDashboardStats();
const inbox = getTodayInbox();
const showSampleBanner = getShowSampleBanner();
const today = getMinskParts().date;
const recentOrders = db.select().from(orders).orderBy(desc(orders.id)).all();
const revDelta =
  s.prevMonth.revenue > 0
    ? Math.round(((s.month.revenue - s.prevMonth.revenue) / s.prevMonth.revenue) * 100)
    : s.month.revenue > 0
      ? 100
      : 0;
---

<AdminLayout title="Дашборд">
  <GarageToday client:load orders={recentOrders} today={today} />
  <SiteBannerToggle client:load initialOn={showSampleBanner} />

  <section class="admin-kpi">
    <article>
      <span>Заявки сегодня</span>
      <strong>{s.today.orders}</strong>
    </article>
    <article>
      <span>Выручка сегодня</span>
      <strong>{formatByn(s.today.revenue)}</strong>
    </article>
    <article>
      <span>За неделю</span>
      <strong>{s.week.orders}</strong>
      <small style="color:#8a8580;">{formatByn(s.week.revenue)}</small>
    </article>
    <article>
      <span>За месяц</span>
      <strong>{s.month.orders}</strong>
      <small style="color:#8a8580;">{formatByn(s.month.revenue)} · Δ {revDelta}%</small>
    </article>
    <article>
      <span>Средний чек</span>
      <strong>{formatByn(s.month.avg)}</strong>
    </article>
    <article>
      <span>Конверсия сайта</span>
      <strong>{s.month.conversion}%</strong>
      <small style="color:#8a8580;">
        form_success {s.month.conversionFormSuccess} / calc_open {s.month.conversionCalcOpen}
      </small>
    </article>
    <article>
      <span>Прибыль (мес.)</span>
      <strong style={`color:${s.month.profit >= 0 ? '#3dd68c' : '#ff5c5c'}`}>
        {formatByn(Math.round(s.month.profit))}
      </strong>
      <small style="color:#8a8580;">− расходы {formatByn(Math.round(s.month.expenses))}</small>
    </article>
    <article>
      <span>Inbox сегодня</span>
      <strong>{inbox.counts.total}</strong>
      <small style="color:#8a8580;">
        <a href="/admin/inbox" style="color:#8a8580;">открыть →</a>
      </small>
    </article>
  </section>

  <section style="margin-top:1.25rem;">
    <div style="display:flex; justify-content:space-between; align-items:baseline; gap:0.75rem; flex-wrap:wrap; margin-bottom:0.5rem;">
      <h2 style="margin:0; font-size:1.05rem;">Входящие на сегодня</h2>
      <a href="/admin/inbox" style="color:#8a8580; font-size:0.85rem;">Полный inbox</a>
    </div>
    <InboxPanel
      client:load
      compact
      today={inbox.today}
      newOrders={inbox.newOrders}
      openLeads={inbox.openLeads}
      otaDue={inbox.otaDue}
    />
  </section>

  <section class="dash-grid">
    <div style="background:#14171a; border:1px solid #22262a; border-radius:12px; padding:1rem;">
      <h2 style="margin:0 0 0.75rem; font-size:1rem;">Заявки и выручка · 14 дней</h2>
      <DashboardCharts client:load days={s.days} />
    </div>
    <div style="display:grid; gap:1rem;">
      <div style="background:#14171a; border:1px solid #22262a; border-radius:12px; padding:1rem;">
        <h2 style="margin:0 0 0.75rem; font-size:1rem;">Топ-3 модели</h2>
        <ol style="margin:0; padding-left:1.1rem;">
          {s.topModels.length === 0 && <li style="color:#8a8580;">Пока нет заказов</li>}
          {s.topModels.map(([name, n]) => (
            <li>
              {name} <strong>· {n}</strong>
            </li>
          ))}
        </ol>
      </div>
      <div style="background:#14171a; border:1px solid #22262a; border-radius:12px; padding:1rem;">
        <h2 style="margin:0 0 0.75rem; font-size:1rem;">Топ-3 источника</h2>
        <ol style="margin:0; padding-left:1.1rem;">
          {s.topSources.length === 0 && <li style="color:#8a8580;">Нет данных UTM</li>}
          {s.topSources.map(([name, n]) => (
            <li>
              {name} <strong>· {n}</strong>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
</AdminLayout>

<style>
  .dash-grid {
    margin-top: 1.25rem;
    display: grid;
    grid-template-columns: 1.4fr 0.8fr;
    gap: 1rem;
  }
  @media (max-width: 1000px) {
    .dash-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
