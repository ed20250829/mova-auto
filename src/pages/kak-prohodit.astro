---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { faqPageJsonLd, howToJsonLd, organizationJsonLd, SITE_PHONE_DISPLAY } from '../lib/seo';

const title = 'Как проходит русификация авто в Минске | Мова';
const description =
  'Фото экрана → слот → визит в Минске → проверка меню. Обычно 40–60 минут. Фикс-цена в BYN до записи.';

const steps = [
  {
    n: '01',
    title: 'Фото экрана и модель',
    text: 'Пришлите фото главного экрана и укажите марку. Подтвердим, что можем сделать, и покажем фикс-цену в BYN.',
  },
  {
    n: '02',
    title: 'Запись на слот',
    text: 'Выберите дату и время на сайте или напишите в Telegram. На связи 08:00–22:00 по Минску.',
  },
  {
    n: '03',
    title: 'Визит',
    text: 'Приезжаете на ул. Виталия Цвирко 78, Минск (или выезд — по записи). База обычно 40–60 минут; сложные модели — до 2–3 часов.',
  },
  {
    n: '04',
    title: 'Проверка экранов',
    text: 'Вместе проходим меню и настройки. Приложения и страховка после обновления ПО — отдельные опции, если нужны.',
  },
];

const faq = [
  {
    q: 'Нужна ли предоплата?',
    a: 'Нет. Оплата после работы — на месте, переводом или по ссылке от мастера.',
  },
  {
    q: 'Что взять с собой?',
    a: 'Авто и доступ к мультимедиа. Если есть аккаунт/пароль к системе — подготовьте заранее. Остальное уточним при записи.',
  },
  {
    q: 'Можно ли с выездом?',
    a: `Выезд по Минску — отдельная опция за 100 BYN. Из области — логистику обсуждаем при записи. Телефон: ${SITE_PHONE_DISPLAY}.`,
  },
] as const;
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[organizationJsonLd(), howToJsonLd(), faqPageJsonLd(faq)]}
>
  <SiteHeader />
  <main id="main" class="section">
    <div class="container how-page">
      <p class="kicker">Процесс</p>
      <h1 class="display">Как проходит русификация</h1>
      <p class="lead muted">
        Короткий порядок без сюрпризов: сначала цена и слот, потом визит в Минске и проверка меню вместе.
      </p>

      <ol class="steps">
        {steps.map((s) => (
          <li>
            <span class="step-n" aria-hidden="true">{s.n}</span>
            <div>
              <h2>{s.title}</h2>
              <p class="muted">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="cta-row">
        <a class="btn" href="/#booking">Выбрать слот</a>
        <a class="btn btn-ghost" href="/#calculator">Узнать цену</a>
        <a class="btn btn-ghost" href="/sravnenie">Что входит</a>
      </div>

      <section class="faq-block" aria-labelledby="how-faq">
        <h2 id="how-faq" class="display section-title">Частые вопросы</h2>
        <div class="faq-list">
          {faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p class="muted">{item.a}</p>
            </details>
          ))}
        </div>
      </section>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  h1.display {
    font-size: clamp(2rem, 5vw, 3.1rem);
    margin: 0.35rem 0 0;
    max-width: 16ch;
  }
  .lead {
    max-width: 54ch;
    margin: 0.95rem 0 0;
    line-height: 1.55;
  }
  .steps {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.15rem;
    max-width: 640px;
  }
  .steps li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem 1.1rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border);
  }
  .step-n {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.35rem;
    letter-spacing: -0.04em;
    color: var(--accent);
    line-height: 1;
    padding-top: 0.15rem;
  }
  .steps h2 {
    margin: 0;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }
  .steps p {
    margin: 0.4rem 0 0;
    line-height: 1.5;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }
  .section-title {
    font-size: clamp(1.45rem, 3.2vw, 2rem);
    margin: 0 0 0.85rem;
  }
  .faq-block {
    margin-top: 2.75rem;
  }
  .faq-list {
    display: grid;
    gap: 0.55rem;
    max-width: 640px;
  }
  details {
    border-top: 1px solid var(--border);
    padding: 0.85rem 0 0.35rem;
  }
  summary {
    cursor: pointer;
    font-weight: 600;
  }
  details p {
    margin: 0.55rem 0 0.35rem;
    line-height: 1.5;
  }
  @media (max-width: 640px) {
    h1.display {
      max-width: none;
    }
  }
</style>
