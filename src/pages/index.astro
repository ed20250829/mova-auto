---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Calculator from '../components/client/Calculator';
import BookingForm from '../components/client/BookingForm';
import Faq from '../components/client/Faq';
import SmoothScroll from '../components/client/SmoothScroll';
import HeroMotion from '../components/client/HeroMotion';
import { FAQ_ITEMS } from '../lib/faq-items';
import { getAllModels } from '../lib/models';
import {
  faqPageJsonLd,
  howToJsonLd,
  localBusinessJsonLd,
  organizationJsonLd,
} from '../lib/seo';
import { getPublishedCases } from '../lib/cases';

const models = getAllModels();
const calcModels = models.map((m) => ({
  id: m.id,
  brand: m.brand,
  brandSlug: m.brandSlug,
  model: m.model,
  modelSlug: m.modelSlug,
  priceBase: m.priceBase,
  timeMinutes: m.timeMinutes,
  complexity: m.complexity,
  requiresOtaSubscription: m.requiresOtaSubscription,
  notes: m.notes,
}));

const brands = [...new Map(models.map((m) => [m.brand, m.brandSlug])).entries()];
const publishedCases = getPublishedCases();
---

<BaseLayout
  title="Мова - русификация китайских авто в Минске"
  description="Русификация меню китайских авто в Минске, Parkland 1. Фикс-цена в BYN, запись онлайн, гарантия 6 месяцев. Мова — язык твоего авто."
  jsonLd={[organizationJsonLd(), localBusinessJsonLd(), howToJsonLd(), faqPageJsonLd(FAQ_ITEMS)]}
>
  <SmoothScroll client:load />
  <SiteHeader />
  <main id="main">
    <section class="hero section">
      <HeroMotion client:load />
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="brand display" data-hero-reveal>Мова</p>
          <h1 class="display" data-hero-reveal>
            Язык твоего авто
          </h1>
          <p class="lead muted" data-hero-reveal>
            Русификация меню китайских авто в Минске. Фикс-цена в BYN. Гарантия 6 месяцев. Запись онлайн.
          </p>
          <p class="hero-aside muted" data-hero-reveal>
            Яндекс-приложения (Алиса, Карты, Музыка) — где позволяет система
          </p>
          <div class="hero-cta" data-hero-reveal>
            <a class="btn" href="#calculator">Узнать цену</a>
            <a class="btn btn-ghost" href="#booking">Выбрать слот</a>
          </div>
          <div class="hero-scene" aria-hidden="true">
            <span class="cn" data-hero-cn>设置 · 系统 · 导航</span>
            <span class="arrow">→</span>
            <span class="ru" data-hero-ru>Настройки · Система · Навигация</span>
          </div>
        </div>
        <div id="calculator" class="hero-calc" data-hero-reveal>
          <Calculator client:load models={calcModels} />
        </div>
      </div>
    </section>

    <section class="section" id="segments">
      <div class="container">
        <p class="kicker">Кому подходит</p>
        <h2 class="display section-title">Разная ситуация - разный ответ</h2>
        <div class="segments">
          <article>
            <h3>Новичок</h3>
            <p class="muted">Купили авто в Минске. Меню непонятное - трудно разобраться с экраном.</p>
            <p>Цена по модели в BYN. Пакет Яндекс-приложений - 220 BYN (mass) или 450 BYN для Li, Zeekr, Avatr, где система позволяет.</p>
            <a class="btn" href="#calculator">Показать цену по модели</a>
          </article>
          <article>
            <h3>Уже пробовал</h3>
            <p class="muted">Дешёвый мастер. После обновления меню снова чужое. Деньги ушли впустую.</p>
            <p>Страховка после обновления ПО - отдельно от приложений. Подписка. Гарантия 6 месяцев. Повтор без полной оплаты заново.</p>
            <a class="btn" href="#booking">Записаться со страховкой обновлений</a>
          </article>
          <article>
            <h3>Импортёр</h3>
            <p class="muted">5-15 машин в месяц. Покупатель возвращается: экран снова непонятный.</p>
            <p>Сетка от 5 авто/мес. Приоритетные слоты по Минску. Статус готовности в Telegram. Отчёт за месяц.</p>
            <a class="btn" href="/segments/importers">Условия для импортёров</a>
          </article>
          <article>
            <h3>Автосалон</h3>
            <p class="muted">Официальные продажи в Беларуси. Нужны договор и закрывающие к выдаче.</p>
            <p>Договор. Закрывающие. Цена по модели в BYN. Слот под выдачу. Отчёт по каждой машине.</p>
            <a class="btn btn-ghost" href="/partneram">Автосалонам</a>
          </article>
        </div>
      </div>
    </section>

    <section class="section-tight">
      <div class="container brands-block">
        <div>
          <p class="kicker">База моделей</p>
          <h2 class="display section-title">40+ моделей в прайсе</h2>
          <p class="muted">Цена и время по каждой - для Минска, в BYN. Откройте карточку модели или посчитайте в калькуляторе.</p>
        </div>
        <div class="brand-chips">
          {brands.map(([b, slug]) => (
            <a class="chip" href={`/auto/${slug}`}>
              {b}
            </a>
          ))}
        </div>
        <div class="model-links">
          {models.slice(0, 12).map((m) => (
            <a class="model-link" href={`/auto/${m.brandSlug}/${m.modelSlug}`}>
              <span class="model-link-main">{m.brand} {m.model}</span>
              <span class="model-link-price">{m.priceBase}&nbsp;BYN</span>
            </a>
          ))}
        </div>
        <p class="muted" style="margin-top:1rem;">
          Полный список - в калькуляторе выше. Там же BYD, Geely, Zeekr, Li Auto и остальные марки из прайса.
        </p>
      </div>
    </section>

    <section class="section" id="honest">
      <div class="container honest">
        <div>
          <p class="kicker">Честно</p>
          <h2 class="display section-title">Что делаем. Чего не делаем.</h2>
        </div>
        <div class="honest-grid">
          <div>
            <h3>Делаем</h3>
            <ul>
              <li>Базовая русификация: меню и настройки, где позволяет система</li>
              <li>Пакет Яндекс-приложений (Алиса, Карты, Музыка) — 220 / 450 BYN, где технически возможно</li>
              <li>Страховка после обновления ПО — по подписке, отдельно</li>
              <li>Фикс-цена базы до визита · гарантия 6 месяцев на меню</li>
            </ul>
          </div>
          <div>
            <h3>Не делаем</h3>
            <ul>
              <li>Ремонт и диагностика узлов</li>
              <li>Тюнинг и чип ради мощности</li>
              <li>Не обещаем приложения, которые система не пускает</li>
              <li>Скрытых доплат на месте</li>
            </ul>
          </div>
        </div>
        <p class="muted guarantee-note">
          Гарантия 6 месяцев — на выполненную русификацию меню. Нужна защита языка после обновления ПО — отдельная подписка, не «растянутая» гарантия в рекламе.
          <a href="/sravnenie">Сравнение с типичным СТО</a>
          ·
          <a href="/kak-prohodit">Как проходит</a>
          ·
          <a href="/cena">Цены</a>
        </p>
      </div>
    </section>

    {
      publishedCases.length > 0 && (
        <section class="section-tight" id="cases">
          <div class="container">
            <p class="kicker">Работы</p>
            <h2 class="display section-title">Реальные визиты в Минске</h2>
            <p class="muted cases-lead">
              Фото с приёмки: модель и коротко, что сделали. Без чужих картинок и без обещаний «до/после».
            </p>
            <div class="cases-grid">
              {publishedCases.map((c) => (
                <figure class="case-slot">
                  <div class="case-frame">
                    <img src={c.imagePath} alt={`${c.title} — русификация меню`} loading="lazy" />
                  </div>
                  <figcaption>
                    <strong>{c.title}</strong>
                    <span class="muted">{c.description}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <section class="section" id="faq">
      <div class="container faq-grid">
        <div>
          <p class="kicker">FAQ</p>
          <h2 class="display section-title">Короткие ответы</h2>
          <p class="muted">Если ответа нет - напишите в Telegram. Ответим из Минска, по делу.</p>
        </div>
        <Faq client:visible />
      </div>
    </section>

    <section class="section" id="booking">
      <div class="container booking-wrap">
        <BookingForm client:visible models={calcModels} />
        <p class="booking-partner-link muted">
          Автосалону или импортёру -
          <a href="/partneram">условия для партнёров</a>
        </p>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .hero {
    padding-top: clamp(1.5rem, 4vw, 2.75rem);
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
    overflow-x: clip;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(1.25rem, 3.5vw, 2.5rem);
    align-items: start;
  }
  .hero-calc {
    min-width: 0;
  }
  @media (min-width: 1024px) {
    .hero-calc {
      position: sticky;
      top: 1rem;
    }
  }
  .brand {
    font-size: clamp(3.4rem, 9vw, 5.8rem);
    margin: 0;
    color: var(--accent);
    line-height: 0.9;
    letter-spacing: -0.05em;
  }
  h1.display {
    font-size: clamp(1.7rem, 3.8vw, 2.45rem);
    margin: 0.45rem 0 0;
    max-width: 12ch;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text);
  }
  .lead {
    font-size: 1.05rem;
    max-width: 36ch;
    margin: 0.95rem 0 0;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .hero-aside {
    margin: 0.55rem 0 0;
    font-size: 0.88rem;
    max-width: 40ch;
    line-height: 1.45;
    color: #c2bbb3;
    text-wrap: pretty;
  }
  @media (min-width: 1024px) {
    .lead {
      max-width: 42ch;
    }
    .hero-aside {
      max-width: 44ch;
    }
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1.2rem;
  }
  .hero-scene {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 0.75rem;
    align-items: center;
    font-size: clamp(0.88rem, 2vw, 1.05rem);
    letter-spacing: -0.02em;
  }
  .hero-scene .cn {
    color: #d2ccc4;
    text-decoration: line-through;
    text-decoration-thickness: 1.5px;
    text-decoration-color: color-mix(in srgb, #d2ccc4 55%, transparent);
  }
  .hero-scene .arrow {
    color: var(--accent);
    font-weight: 900;
  }
  .hero-scene .ru {
    font-weight: 700;
    color: var(--text);
  }
  .section-title {
    font-size: clamp(1.7rem, 3.8vw, 2.45rem);
    margin: 0.4rem 0 1.35rem;
    max-width: 18ch;
    text-wrap: balance;
  }
  .segments {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 3vw, 2.25rem);
    row-gap: 0;
    align-items: stretch;
  }
  .segments article {
    padding: 1.15rem 0 1.35rem;
    border-top: 1px solid var(--border-strong);
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    min-width: 0;
    height: 100%;
  }
  .segments article > p {
    max-width: 48ch;
    text-wrap: pretty;
  }
  .segments h3 {
    margin: 0;
    font-size: 1.3rem;
    letter-spacing: -0.03em;
  }
  .segments .btn {
    align-self: flex-start;
    min-height: 42px;
    margin-top: auto;
  }
  .brand-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }
  .model-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    column-gap: 1.5rem;
    row-gap: 0;
  }
  .model-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.7rem 0.75rem 0.7rem 0;
    border-bottom: 1px solid var(--border);
    min-width: 0;
  }
  .model-link-main {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .model-link-price {
    color: var(--text);
    font-weight: 700;
    flex-shrink: 0;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
  }
  .honest {
    display: grid;
    gap: 0.15rem;
  }
  .honest-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.75rem, 4vw, 3rem);
    width: 100%;
    margin-top: 0.35rem;
  }
  .honest-grid > div {
    min-width: 0;
    padding-top: 0.95rem;
    border-top: 1px solid var(--border-strong);
  }
  .honest-grid h3 {
    margin: 0;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }
  .honest-grid ul {
    margin: 0.65rem 0 0;
    padding-left: 1.1rem;
    color: var(--text-muted);
    display: grid;
    gap: 0.45rem;
    max-width: 46ch;
    text-wrap: pretty;
  }
  .guarantee-note {
    margin: 1.5rem 0 0;
    max-width: 58ch;
    line-height: 1.5;
    font-size: 0.92rem;
    text-wrap: pretty;
  }
  .guarantee-note a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .cases-lead {
    max-width: 52ch;
    margin: -0.5rem 0 1.25rem;
    text-wrap: pretty;
  }
  .cases-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.85rem, 2vw, 1.25rem);
  }
  .case-slot {
    margin: 0;
  }
  .case-frame {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    overflow: hidden;
  }
  .case-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .case-slot figcaption {
    display: grid;
    gap: 0.15rem;
    margin-top: 0.55rem;
    font-size: 0.9rem;
  }
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(12rem, 0.72fr) minmax(0, 1.28fr);
    column-gap: clamp(1.75rem, 4vw, 3.25rem);
    row-gap: 1.25rem;
    align-items: start;
  }
  .faq-grid > div:first-child {
    position: sticky;
    top: calc(var(--header-offset) + 0.5rem);
  }
  .faq-grid > div:first-child .muted {
    max-width: 32ch;
    text-wrap: pretty;
  }
  .booking-wrap {
    max-width: 56rem;
    margin-inline: auto;
  }
  .booking-partner-link {
    margin: 0.85rem 0 0;
    font-size: 0.86rem;
    text-align: center;
  }
  .booking-partner-link a {
    color: var(--text-muted);
    text-underline-offset: 0.18em;
  }
  .booking-partner-link a:hover {
    color: var(--text);
    text-decoration: underline;
  }

  @media (max-width: 1023px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-copy {
      order: 1;
    }
    .hero-calc {
      order: 2;
    }
  }

  @media (max-width: 900px) {
    .cases-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .segments,
    .honest-grid,
    .faq-grid,
    .model-links {
      grid-template-columns: 1fr;
    }
    .faq-grid > div:first-child {
      position: static;
    }
    .honest-grid {
      gap: 1.25rem;
    }
    .segments .btn {
      margin-top: 0.35rem;
    }
    h1.display {
      max-width: none;
    }
    .hero-cta .btn,
    .hero-cta .btn-ghost {
      flex: 1 1 auto;
      min-width: min(100%, 10rem);
    }
    .model-link {
      padding-inline-end: 0;
    }
  }

  @media (max-width: 390px) {
    .container {
      width: min(1180px, calc(100% - 1.25rem));
    }
    .brand {
      font-size: clamp(2.9rem, 14vw, 3.6rem);
    }
    .hero-scene {
      font-size: 0.84rem;
      gap: 0.4rem 0.55rem;
    }
    .calc-brands {
      gap: 0.3rem;
    }
    .lead,
    .hero-aside {
      max-width: none;
    }
  }

  @media (max-width: 360px) {
    .brand {
      font-size: 2.7rem;
    }
    .hero-cta .btn,
    .hero-cta .btn-ghost {
      width: 100%;
    }
  }
</style>
