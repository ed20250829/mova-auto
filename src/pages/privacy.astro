---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import {
  PRIVACY_UPDATED,
  privacyFooterNote,
  privacyIntro,
  privacySections,
} from '../lib/privacy-policy';
---

<BaseLayout
  title="Политика обработки персональных данных — Мова"
  description="Как сервис Мова в Минске обрабатывает имя, телефон и данные заявок на русификацию авто. Простым языком."
>
  <SiteHeader />
  <main id="main" class="section">
    <article class="container privacy-page">
      <p class="kicker">Документы · Минск</p>
      <h1 class="display privacy-title">Политика обработки персональных данных</h1>
      <p class="muted privacy-lead">{privacyIntro}</p>
      <p class="muted privacy-updated">Обновлено: {PRIVACY_UPDATED}</p>

      {
        privacySections.map((section) => (
          <section class="privacy-block" id={section.id}>
            <h2>{section.title}</h2>
            {section.paragraphs.map((p) => (
              <p class="muted">{p}</p>
            ))}
          </section>
        ))
      }

      <p class="muted privacy-note">{privacyFooterNote}</p>
      <p class="privacy-back">
        <a href="/">← На главную</a>
        <a class="btn btn-ghost" href="/#booking">К записи</a>
      </p>
    </article>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .privacy-page {
    max-width: 42rem;
    display: grid;
    gap: 1rem;
  }
  .privacy-title {
    font-size: clamp(1.85rem, 4.5vw, 2.75rem);
    margin: 0;
    line-height: 1.1;
  }
  .privacy-lead {
    margin: 0;
    font-size: 1.05rem;
  }
  .privacy-updated {
    margin: 0;
    font-size: 0.85rem;
  }
  .privacy-block {
    display: grid;
    gap: 0.55rem;
    padding-top: 0.35rem;
  }
  .privacy-block h2 {
    margin: 0;
    font-size: 1.15rem;
    font-family: var(--font-display);
    letter-spacing: -0.02em;
  }
  .privacy-block p {
    margin: 0;
  }
  .privacy-note {
    margin: 0.5rem 0 0;
    font-size: 0.88rem;
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }
  .privacy-back {
    margin: 0.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }
</style>
