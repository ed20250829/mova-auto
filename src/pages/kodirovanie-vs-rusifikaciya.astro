---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { faqPageJsonLd, organizationJsonLd } from '../lib/seo';

const title = 'Кодирование или русификация меню — в чём разница | Мова';
const description =
  'Коротко: русификация меню мультимедиа ≠ кодирование блоков автомобиля. Что делает Мова в Минске и чего не обещаем.';

const faq = [
  {
    q: 'Что такое русификация авто у Мовы?',
    a: 'Русский язык в меню и настройках мультимедиа — где позволяет система. Плюс опционально Яндекс-приложения и страховка языка после обновления ПО.',
  },
  {
    q: 'Чем это отличается от кодирования?',
    a: 'Кодирование обычно про скрытые функции блоков автомобиля (удобства, ассистенты и т.п.). Русификация меню — про язык интерфейса экрана. Это разные услуги.',
  },
  {
    q: 'Делаете ли вы кодирование Haval / Geely?',
    a: 'Основной продукт Мовы — русификация меню. Если нужна другая работа — скажем честно, берём ли вашу модель и что входит в базу.',
  },
] as const;
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[organizationJsonLd(), faqPageJsonLd(faq)]}
>
  <SiteHeader />
  <main id="main" class="section">
    <div class="container article-page">
      <p class="kicker">Разбор</p>
      <h1 class="display">Кодирование и русификация</h1>
      <p class="lead muted">
        В поиске эти слова часто стоят рядом. Ниже — простая разница, без жаргона и без пугалок.
      </p>

      <section class="block">
        <h2>Русификация меню</h2>
        <p class="muted">
          Экран становится понятным: настройки, пункты меню, часть системы — на русском, если система это позволяет.
          У Мовы цена фиксирована в BYN по модели, запись онлайн, работа в Минске.
        </p>
      </section>

      <section class="block">
        <h2>Кодирование</h2>
        <p class="muted">
          Обычно про активацию или настройку функций автомобиля через блоки управления — не про перевод меню экрана.
          Состав, риски и гарантия у такой услуги другие. Не смешиваем с базовой русификацией в одном обещании.
        </p>
      </section>

      <section class="block">
        <h2>Что выбрать</h2>
        <p class="muted">
          Нужен русский в меню — смотрите калькулятор Мовы и карточку модели. Нужен широкий пакет со смежными работами —
          сравните состав у СТО и уточните у нас, что реально входит в базу:
          <a href="/sravnenie">страница сравнения</a>.
        </p>
        <div class="cta-row">
          <a class="btn" href="/#calculator">Цена по модели</a>
          <a class="btn btn-ghost" href="/cena">Сколько стоит</a>
        </div>
      </section>

      <section class="faq-block" aria-labelledby="kod-faq">
        <h2 id="kod-faq" class="display section-title">Вопросы</h2>
        <div class="faq-list">
          {faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p class="muted">{item.a}</p>
            </details>
          ))}
        </div>
      </section>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  h1.display {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0.35rem 0 0;
    max-width: 16ch;
  }
  .lead {
    max-width: 56ch;
    margin: 0.95rem 0 0;
    line-height: 1.55;
  }
  .block {
    margin-top: 2rem;
    max-width: 62ch;
  }
  .block h2 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }
  .block p {
    margin: 0;
    line-height: 1.55;
  }
  .block a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.1rem;
  }
  .section-title {
    font-size: clamp(1.45rem, 3.2vw, 2rem);
    margin: 0 0 0.85rem;
  }
  .faq-block {
    margin-top: 2.75rem;
  }
  .faq-list {
    display: grid;
    gap: 0.55rem;
    max-width: 640px;
  }
  details {
    border-top: 1px solid var(--border);
    padding: 0.85rem 0 0.35rem;
  }
  summary {
    cursor: pointer;
    font-weight: 600;
  }
  details p {
    margin: 0.55rem 0 0.35rem;
    line-height: 1.5;
  }
  @media (max-width: 640px) {
    h1.display {
      max-width: none;
    }
  }
</style>
