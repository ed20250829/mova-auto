---
import '../styles/global.css';
import SampleBanner from '../components/client/SampleBanner';
import CookieBanner from '../components/client/CookieBanner';
import CallbackWidget from '../components/client/CallbackWidget';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  robots?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'Мова - русификация китайских авто в Минске',
  description = 'Русификация мультимедиа китайских авто в Минске, Беларусь. Фикс-цена в BYN, запись онлайн, гарантия 6 месяцев.',
  ogImage = '/og.png',
  robots,
  jsonLd,
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') || 'https://mova-auto.tech';
const canonical = new URL(Astro.url.pathname, site).toString();
const ld = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];

/** Demo banner: runtime hoster `.env` OR build-time PUBLIC_ OR local `astro dev`. */
const showSampleBanner =
  process.env.PUBLIC_SHOW_SAMPLE_BANNER === '1' ||
  import.meta.env.PUBLIC_SHOW_SAMPLE_BANNER === '1' ||
  import.meta.env.DEV;

/** Yandex Metrika: only inject id when set; script loads after cookie accept. */
const yandexMetrikaId = String(
  process.env.PUBLIC_YANDEX_METRIKA_ID || import.meta.env.PUBLIC_YANDEX_METRIKA_ID || '',
).trim();

/** Google Tag Manager: only inject id when set; container loads after cookie accept. */
const gtmId = String(process.env.PUBLIC_GTM_ID || import.meta.env.PUBLIC_GTM_ID || '').trim();
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_BY" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site).toString()} />
    <meta property="og:site_name" content="Мова" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="geo.region" content="BY-MI" />
    <meta name="geo.placename" content="Минск" />
    <meta name="theme-color" content="#0E0F10" />
    <meta name="msapplication-TileColor" content="#0E0F10" />
    <meta name="apple-mobile-web-app-title" content="Мова" />
    <meta name="application-name" content="Мова" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#FF5722" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link href="https://api.fontshare.com/v2/css?f[]=satoshi@500,700,900&f[]=general-sans@500,600,700&display=swap" rel="stylesheet" />
    {ld.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
  </head>
  <body>
    <a class="sr-only" href="#main">К содержанию</a>
    {showSampleBanner && <SampleBanner client:load />}
    <slot />
    <CookieBanner client:load metrikaId={yandexMetrikaId || undefined} gtmId={gtmId || undefined} />
    <CallbackWidget client:load />
  </body>
</html>
