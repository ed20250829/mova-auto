---
/**
 * Brand / social proof ticker — CSS marquee (desktop), fade carousel (mobile).
 * Content from props or data/ticker.json via getManifestoItems / getSocialItems.
 */
export type TickerItemProp = {
  id?: string;
  text: string;
  href?: string;
};

interface Props {
  items: TickerItemProp[];
  speed?: number;
  variant?: 'brand' | 'social' | 'nav';
  pauseOnHover?: boolean;
  direction?: 'left' | 'right';
  ariaLabel?: string;
  /** When true (social), tiny script may refresh from /api/ticker. */
  live?: boolean;
  class?: string;
}

const {
  items,
  speed = 50,
  variant = 'brand',
  pauseOnHover = true,
  direction = 'left',
  ariaLabel = 'Лента Мова',
  live = false,
  class: className = '',
} = Astro.props;

const safeItems = (items || []).filter((i) => i?.text?.trim());
const loop = safeItems.length ? [...safeItems, ...safeItems] : [];
const uid = `ticker-${variant}`;
---

{
  safeItems.length > 0 && (
    <div
      id={uid}
      class:list={['mova-ticker', `mova-ticker--${variant}`, className]}
      data-ticker
      data-variant={variant}
      data-live={live ? '1' : '0'}
      data-speed={speed}
      data-direction={direction}
      data-pause-hover={pauseOnHover ? '1' : '0'}
      style={`--ticker-duration: ${speed}s;`}
      role="region"
      aria-label={ariaLabel}
    >
      <div class="mova-ticker__track" data-ticker-track aria-hidden="true">
        <div
          class:list={[
            'mova-ticker__marquee',
            direction === 'right' && 'is-reverse',
            pauseOnHover && 'is-pause-hover',
          ]}
        >
          {loop.map((item, i) =>
            item.href ? (
              <a class="mova-ticker__item" href={item.href} data-ticker-link data-id={item.id || i}>
                <span>{item.text}</span>
                <span class="mova-ticker__sep" aria-hidden="true">
                  ·
                </span>
              </a>
            ) : (
              <span class="mova-ticker__item" data-id={item.id || i}>
                <span>{item.text}</span>
                <span class="mova-ticker__sep" aria-hidden="true">
                  ·
                </span>
              </span>
            ),
          )}
        </div>
      </div>

      <div class="mova-ticker__fade" data-ticker-fade>
        {safeItems.map((item, i) =>
          item.href ? (
            <a
              class:list={['mova-ticker__fade-item', i === 0 && 'is-active']}
              href={item.href}
              data-ticker-link
              data-id={item.id || i}
            >
              {item.text}
            </a>
          ) : (
            <span class:list={['mova-ticker__fade-item', i === 0 && 'is-active']} data-id={item.id || i}>
              {item.text}
            </span>
          ),
        )}
      </div>

      <p class="sr-only">{safeItems.map((i) => i.text).join('. ')}</p>
    </div>
  )
}

<style>
  .mova-ticker {
    --ticker-fg: var(--text);
    --ticker-bg: var(--ink, #0e0f10);
    --ticker-h: 36px;
    position: relative;
    z-index: 41;
    height: var(--ticker-h);
    background: var(--ticker-bg);
    color: var(--ticker-fg);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
    overflow: hidden;
    user-select: none;
  }
  .mova-ticker--nav,
  .mova-ticker--brand {
    position: sticky;
    top: 0;
  }
  .mova-ticker--social {
    border-top: 1px solid var(--border);
    background: color-mix(in srgb, var(--ink, #0e0f10) 92%, var(--accent) 8%);
  }

  .mova-ticker__track {
    height: 100%;
    display: flex;
    align-items: center;
    mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
  }
  .mova-ticker__marquee {
    display: flex;
    flex-wrap: nowrap;
    width: max-content;
    animation: mova-ticker-x var(--ticker-duration, 50s) linear infinite;
    will-change: transform;
  }
  .mova-ticker__marquee.is-reverse {
    animation-direction: reverse;
  }
  .mova-ticker__marquee.is-pause-hover:hover {
    animation-play-state: paused;
  }
  .mova-ticker__item {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    gap: 0;
    padding: 0 0.15rem;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }
  .mova-ticker__item:hover span:first-child,
  .mova-ticker__item:focus-visible span:first-child {
    color: var(--accent);
  }
  .mova-ticker__item:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .mova-ticker__sep {
    margin-inline: 1.1rem;
    color: var(--accent);
    font-weight: 700;
  }

  .mova-ticker__fade {
    display: none;
    height: 100%;
    align-items: center;
    justify-content: center;
    padding: 0 1rem;
    text-align: center;
  }
  .mova-ticker__fade-item {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 1.25rem;
    color: inherit;
    text-decoration: none;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.45s var(--ease-out),
      transform 0.45s var(--ease-out);
    pointer-events: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mova-ticker__fade-item.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  @keyframes mova-ticker-x {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* Mobile 35+: fade one phrase — less busy than marquee */
  @media (max-width: 767px) {
    .mova-ticker {
      --ticker-h: 32px;
      font-size: 11px;
    }
    .mova-ticker__track {
      display: none;
    }
    .mova-ticker__fade {
      display: flex;
      position: relative;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mova-ticker__marquee {
      animation: none;
      transform: none;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
      max-width: 72.5rem;
      margin-inline: auto;
      padding: 0 var(--page-gutter, 1.25rem);
      gap: 0.25rem 0;
    }
    .mova-ticker__track {
      mask-image: none;
      overflow: hidden;
    }
    .mova-ticker__item:nth-child(n + 5) {
      display: none;
    }
    .mova-ticker__fade-item {
      transition: none;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  function trackTicker(name, meta) {
    try {
      void fetch('/api/events', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, meta }),
        keepalive: true,
      });
    } catch {
      /* ignore */
    }
  }

  function initTicker(root) {
    if (!root || root.dataset.ready === '1') return;
    root.dataset.ready = '1';
    const variant = root.dataset.variant || 'brand';

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            trackTicker('ticker_impression', { variant });
            io.disconnect();
            break;
          }
        }
      },
      { threshold: 0.4 },
    );
    io.observe(root);

    root.addEventListener('click', (ev) => {
      const a = ev.target?.closest?.('[data-ticker-link]');
      if (!a) return;
      trackTicker('ticker_click', {
        variant,
        id: a.getAttribute('data-id') || undefined,
        href: a.getAttribute('href') || undefined,
      });
    });

    const marquee = root.querySelector('.mova-ticker__marquee');
    if (marquee && root.dataset.pauseHover === '1') {
      marquee.addEventListener('mouseenter', () => {
        trackTicker('ticker_pause', { variant, reason: 'hover' });
      });
    }

    // Mobile fade rotator
    const fadeItems = [...root.querySelectorAll('.mova-ticker__fade-item')];
    if (fadeItems.length > 1 && window.matchMedia('(max-width: 767px)').matches) {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce) {
        let idx = 0;
        setInterval(() => {
          fadeItems[idx]?.classList.remove('is-active');
          idx = (idx + 1) % fadeItems.length;
          fadeItems[idx]?.classList.add('is-active');
        }, 4000);
      }
    }

    // Optional live social refresh
    if (root.dataset.live === '1' && variant === 'social') {
      const refresh = () => {
        fetch('/api/ticker')
          .then((r) => r.json())
          .then((data) => {
            const next = Array.isArray(data?.social) ? data.social : [];
            if (!next.length) return;
            const fade = root.querySelector('[data-ticker-fade]');
            const track = root.querySelector('.mova-ticker__marquee');
            if (!fade || !track) return;
            const renderItem = (item, active) => {
              const tag = item.href ? 'a' : 'span';
              const el = document.createElement(tag);
              el.className = 'mova-ticker__fade-item' + (active ? ' is-active' : '');
              if (item.href) el.setAttribute('href', item.href);
              el.setAttribute('data-ticker-link', '');
              if (item.id) el.setAttribute('data-id', item.id);
              el.textContent = item.text;
              return el;
            };
            fade.replaceChildren(...next.map((item, i) => renderItem(item, i === 0)));
            const sepHtml = '<span class="mova-ticker__sep" aria-hidden="true">·</span>';
            const loop = [...next, ...next];
            track.replaceChildren(
              ...loop.map((item) => {
                const tag = item.href ? 'a' : 'span';
                const el = document.createElement(tag);
                el.className = 'mova-ticker__item';
                if (item.href) {
                  el.setAttribute('href', item.href);
                  el.setAttribute('data-ticker-link', '');
                }
                if (item.id) el.setAttribute('data-id', item.id);
                el.innerHTML = `<span></span>${sepHtml}`;
                el.querySelector('span').textContent = item.text;
                return el;
              }),
            );
          })
          .catch(() => {});
      };
      // defer network until idle
      if ('requestIdleCallback' in window) {
        requestIdleCallback(refresh, { timeout: 4000 });
      } else {
        setTimeout(refresh, 2500);
      }
    }
  }

  function boot() {
    document.querySelectorAll('[data-ticker]').forEach(initTicker);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }
</script>
