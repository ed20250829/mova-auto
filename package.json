{
  "name": "mova-auto",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "start": "node server.mjs",
    "astro": "astro",
    "db:seed": "tsx src/db/seed.ts",
