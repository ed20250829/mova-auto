    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.7",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "drizzle-kit": "^0.31.11",
